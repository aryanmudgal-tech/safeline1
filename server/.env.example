# Safeline - Environment Variables
# Copy this file to .env and fill in your API keys

# Twilio (Transport + review-link SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Gradium (TTS / GPT-variant STT)
GRADIUM_API_KEY=
GRADIUM_VOICE_ID=

# OpenAI (LLM for bot-gpt + report extraction)
OPENAI_API_KEY=
# Model used by report_generator.py to extract structured report fields.
REPORT_GEN_MODEL=gpt-4o-mini

# Review UI base URL (used to build the SMS review link) + port
APP_BASE_URL=http://localhost:8080
REVIEW_UI_PORT=8080

# NVIDIA Nemotron ASR (STT)
NVIDIA_ASR_URL=

# NVIDIA Nemotron LLM
NEMOTRON_LLM_URL=
NEMOTRON_ENABLE_THINKING=

# Cekura (evaluation)
CEKURA_API_KEY=
